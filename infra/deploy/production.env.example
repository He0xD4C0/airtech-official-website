# Use immutable tags or digests from the release pipeline. Public, Admin and
# Platform references are separate so each application can roll back alone.
AIRTEK_PUBLIC_WEB_IMAGE=ghcr.io/example/airtekpower-public-web:release-tag
AIRTEK_ADMIN_WEB_IMAGE=ghcr.io/example/airtekpower-admin-web:release-tag
AIRTEK_PLATFORM_IMAGE=ghcr.io/example/airtekpower-platform:release-tag
AIRTEK_MIGRATIONS_IMAGE=ghcr.io/example/airtekpower-migrations:release-tag
AIRTEK_GATEWAY_IMAGE=ghcr.io/example/airtekpower-gateway:release-tag

# The application project joins the long-lived external network created during
# server bootstrap. Application deployment never creates or removes this network.
AIRTEK_APP_PROJECT_NAME=airtek-app
AIRTEK_PRODUCTION_NETWORK=airtek-production

# The outer TLS ingress should be the only process that can reach this listener.
AIRTEK_INGRESS_BIND_ADDRESS=127.0.0.1
AIRTEK_INGRESS_HTTP_PORT=8088
PUBLIC_HOST=www.example.com
ADMIN_HOST=admin.example.com
API_HOST=api.example.com
AIRTEK_PUBLIC_ORIGIN=https://www.example.com
AIRTEK_ADMIN_ORIGIN=https://admin.example.com
AIRTEK_API_ORIGIN=https://api.example.com

# Supply through the deployment secret manager. Remove the setup token from the
# running service after the first Super Admin account has been created.
DATABASE_URL=postgres://airtek_runtime:REPLACE_WITH_RUNTIME_ROLE_PASSWORD@postgres:5432/airtek
# Pre-provision airtek_runtime as the DATABASE_URL login. The dedicated
# airtek_migrator DDL role must own new objects. airtek_runtime must not own the
# database or schema objects and must not have CREATE on public; afterMigrate
# verifies LOGIN and grants CONNECT, DML, TEMPORARY, and read-only migration
# history. The migrator must control these database/schema grants. TLS
# parameters belong in the reviewed JDBC URL.
FLYWAY_URL=jdbc:postgresql://postgres:5432/airtek
FLYWAY_USER=airtek_migrator
FLYWAY_PASSWORD=REPLACE_WITH_MIGRATION_ROLE_PASSWORD
FLYWAY_PLACEHOLDERS_RUNTIME_ROLE=airtek_runtime
# V27 is the only supported application schema target.
AIRTEK_FLYWAY_TARGET=27
AIRTEK_ADMIN_BOOTSTRAP_TOKEN=
# Placeholder only. Inject a secret Base64 value that decodes to exactly 32
# random bytes; never deploy this literal example value.
AIRTEK_TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
# Use independent 32-byte keys without crossing security domains.
AIRTEK_PRODUCT_STAGING_ENCRYPTION_KEY=REPLACE_WITH_DISTINCT_BASE64_ENCODED_32_RANDOM_BYTES
AIRTEK_ANALYTICS_TOKEN_HMAC_KEY=REPLACE_WITH_DISTINCT_BASE64_ENCODED_32_RANDOM_BYTES
# Another independent key encrypts the 24-hour invitation idempotency replay
# envelope. It must never reuse an authentication, staging or analytics key.
AIRTEK_INVITATION_REPLAY_ENCRYPTION_KEY=REPLACE_WITH_DISTINCT_BASE64_ENCODED_32_RANDOM_BYTES
AIRTEK_GUEST_RAW_RETENTION_DAYS=180
AIRTEK_GUEST_AGGREGATE_RETENTION_MONTHS=24
AIRTEK_PRODUCT_IMPORT_MAPPING_VERSION=airtek-basic-v1
# Exact owner-approved Product Master authority. Review and deploy a new tuple
# as one change whenever the source file or mapping changes.
AIRTEK_APPROVED_PRODUCT_MASTER_SHA256=e3b944d5d979c72d963ba353416ef452f9dac0bf63182bb09fc6b1201c043800
AIRTEK_APPROVED_PRODUCT_MASTER_MAPPING_VERSION=airtek-basic-v1
AIRTEK_APPROVED_PRODUCT_MASTER_VALID_ROWS=370
AIRTEK_APPROVED_PRODUCT_MASTER_ERROR_ROWS=5
# Comma-separated, deployment-owned identifiers. Unknown values are rejected
# instead of being persisted as arbitrary text; replace these examples with
# the exact source, medium and campaign identifiers issued for production.
AIRTEK_ANALYTICS_ALLOWED_UTM_SOURCES=google,linkedin,newsletter
AIRTEK_ANALYTICS_ALLOWED_UTM_MEDIUMS=cpc,email,organic-social
AIRTEK_ANALYTICS_ALLOWED_UTM_CAMPAIGNS=replace-with-approved-campaign-id

# Compose assigns only the HTTP gateway a fixed address. Add an outer proxy only
# when its exact internal address is known; never trust a broad private range.
AIRTEK_GATEWAY_INTERNAL_IP=172.29.0.10
AIRTEK_TRUSTED_PROXY_CIDRS=172.29.0.10/32
RUST_LOG=airtek_runtime=info,airtek_http=info,airtek_jobs=info,tower_http=info
