FROM alpine:3.22

ARG TARGETARCH
ARG MC_VERSION=RELEASE.2025-08-13T08-35-41Z
ARG MC_AMD64_SHA256=01f866e9c5f9b87c2b09116fa5d7c06695b106242d829a8bb32990c00312e891
ARG MC_ARM64_SHA256=14c8c9616cfce4636add161304353244e8de383b2e2752c0e9dad01d4c27c12c

RUN apk add --no-cache ca-certificates \
    && case "${TARGETARCH}" in \
      amd64) checksum="${MC_AMD64_SHA256}" ;; \
      arm64) checksum="${MC_ARM64_SHA256}" ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && wget -q \
      "https://github.com/minio/mc/releases/download/${MC_VERSION}/mc.linux-${TARGETARCH}.${MC_VERSION}" \
      -O /usr/local/bin/mc \
    && echo "${checksum}  /usr/local/bin/mc" | sha256sum -c - \
    && chmod 0555 /usr/local/bin/mc

ENTRYPOINT ["mc"]
