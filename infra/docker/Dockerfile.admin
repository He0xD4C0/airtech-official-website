FROM node:22-alpine AS build

WORKDIR /workspace
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV COREPACK_NPM_REGISTRY=${NPM_CONFIG_REGISTRY} \
    NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY} \
    npm_config_registry=${NPM_CONFIG_REGISTRY} \
    NODE_USE_ENV_PROXY=1
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/content-renderer/package.json packages/content-renderer/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm config set registry "${NPM_CONFIG_REGISTRY}" --location=project \
    && pnpm install --frozen-lockfile

COPY apps/admin apps/admin
COPY packages packages
ENV VITE_ENABLE_DEVTOOLS=false
RUN pnpm --filter @airtek/contracts build \
    && pnpm --filter @airtek/admin build:production

FROM nginx:1.27-alpine
ENV ADMIN_API_ORIGIN=http://localhost:8080
ENV ADMIN_MEDIA_IMAGE_SOURCES=https:
RUN apk add --no-cache jq \
    && sed -i '/^user /d' /etc/nginx/nginx.conf \
    && rm -f /etc/nginx/conf.d/default.conf \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid \
    && chown -R nginx:nginx /var/cache/nginx /etc/nginx/conf.d /usr/share/nginx/html
COPY --chown=nginx:nginx apps/admin/deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --chmod=0555 apps/admin/deploy/generate-runtime-config.sh /docker-entrypoint.d/40-airtek-runtime-config.sh
COPY --from=build --chown=nginx:nginx /workspace/apps/admin/dist /usr/share/nginx/html
USER nginx
EXPOSE 3100
