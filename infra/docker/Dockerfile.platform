FROM rust:1.98-slim-bookworm AS build

WORKDIR /workspace
COPY services/platform services/platform
RUN cargo build --locked --release --manifest-path services/platform/Cargo.toml --features production --bin airtek-api --bin airtek-worker --bin airtek-migrate

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home airtek
COPY --from=build /workspace/services/platform/target/release/airtek-api /usr/local/bin/airtek-api
COPY --from=build /workspace/services/platform/target/release/airtek-worker /usr/local/bin/airtek-worker
COPY --from=build /workspace/services/platform/target/release/airtek-migrate /usr/local/bin/airtek-migrate
USER 10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/airtek-api"]
