FROM alpine:3.22

ARG TARGETARCH
ARG MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
ARG MINIO_AMD64_SHA256=7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f
ARG MINIO_ARM64_SHA256=5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d

RUN apk add --no-cache ca-certificates curl \
    && case "${TARGETARCH}" in \
      amd64) checksum="${MINIO_AMD64_SHA256}" ;; \
      arm64) checksum="${MINIO_ARM64_SHA256}" ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && wget -q \
      "https://github.com/minio/minio/releases/download/${MINIO_VERSION}/minio.linux-${TARGETARCH}.${MINIO_VERSION}" \
      -O /usr/local/bin/minio \
    && echo "${checksum}  /usr/local/bin/minio" | sha256sum -c - \
    && chmod 0555 /usr/local/bin/minio

EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["minio"]
