# MinIO server built from the pinned upstream source. MinIO withdrew its public
# container images and prebuilt binaries, so this repository owns the build and
# verifies the checked-out commit before compiling.
ARG GOLANG_IMAGE=golang:1.24.2-bookworm
FROM ${GOLANG_IMAGE} AS build
ARG MINIO_TAG=RELEASE.2025-09-07T16-13-09Z
ARG MINIO_COMMIT=07c3a429bfed433e49018cb0f78a52145d4bedeb
ARG GOPROXY=https://proxy.golang.org,direct
ARG TARGETOS
ARG TARGETARCH
ENV GOPROXY=${GOPROXY} \
    GOTOOLCHAIN=local \
    CGO_ENABLED=0
RUN set -eux; \
    git clone --quiet --depth 1 --branch "${MINIO_TAG}" https://github.com/minio/minio /src; \
    [ "$(git -C /src rev-parse HEAD)" = "${MINIO_COMMIT}" ] \
      || { echo "MinIO source revision does not match the pinned commit ${MINIO_COMMIT}" >&2; exit 1; }
WORKDIR /src
RUN --mount=type=cache,target=/go/pkg/mod \
    set -eu; \
    ldflags="$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go)"; \
    MINIO_RELEASE=RELEASE GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH}" \
      go build -tags kqueue -trimpath --ldflags "$ldflags" -o /out/minio

FROM debian:bookworm-slim
# The Compose healthcheck and the object-storage contracts probe the server with
# curl from inside the container.
RUN set -eux; \
    apt-get update; \
    apt-get install --no-install-recommends -y ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*; \
    useradd --system --uid 10001 --home-dir /home/minio --create-home minio; \
    install -d -o 10001 -g 10001 /data /licenses
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /src/LICENSE /licenses/minio-LICENSE
LABEL org.opencontainers.image.title="airtekpower minio server" \
      org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="07c3a429bfed433e49018cb0f78a52145d4bedeb" \
      org.opencontainers.image.version="RELEASE.2025-09-07T16-13-09Z"
USER 10001
VOLUME ["/data"]
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
