{
  "name": "@airtek/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "pnpm --workspace-root generate:contracts",
    "check:generated": "pnpm --workspace-root check:contracts"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
