# Copy this file to .env for local development. Internal application ports stay
# fixed at Public 3000, Admin 3100 and API 8080; the host-side mappings below
# may be changed when another local process already owns a port.
COMPOSE_PROJECT_NAME=airtekpower
# Set to `minio` to start the bundled local object store; leave empty when the
# Admin GUI will connect the platform to an external S3-compatible service.
COMPOSE_PROFILES=minio
AIRTEK_BIND_ADDRESS=127.0.0.1
AIRTEK_PUBLIC_HOST_PORT=3000
AIRTEK_ADMIN_HOST_PORT=3100
AIRTEK_API_HOST_PORT=8080
AIRTEK_GATEWAY_HOST_PORT=8088
AIRTEK_OBJECT_STORE_HOST_PORT=19000
AIRTEK_OBJECT_STORE_CONSOLE_HOST_PORT=19001

# A complete Compose stack is consumed through the host-routing gateway. Keep
# these separate from direct localhost origins used by native Vite/Rust runs.
AIRTEK_COMPOSE_PUBLIC_ORIGIN=http://www.airtek.localhost:8088
AIRTEK_COMPOSE_ADMIN_ORIGIN=http://admin.airtek.localhost:8088
AIRTEK_COMPOSE_API_ORIGIN=http://api.airtek.localhost:8088
AIRTEK_COMPOSE_MEDIA_ORIGIN=http://media.localhost:19000

# Optional build-network overrides. Empty mirror/proxy values preserve CI and
# production-build behavior; Cargo mirrors must be registry index URLs such as
# sparse+https://rsproxy.cn/index/ rather than crate-download endpoints.
AIRTEK_NPM_REGISTRY=https://registry.npmjs.org
AIRTEK_CARGO_MIRROR=
AIRTEK_BUILD_PROXY=

# Browser-facing origins used by Docker builds. Direct localhost origins keep
# authentication same-site during normal local development.
# The opt-in PostgreSQL diagnostic port and bundled MinIO bind only to loopback.
AIRTEK_POSTGRES_DEBUG_PORT=54320
VITE_PUBLIC_ORIGIN=http://localhost:3000
PUBLIC_ORIGIN=http://localhost:3000
VITE_PUBLIC_API_BASE_URL=http://localhost:8080/api/public/v1
PUBLIC_API_INTERNAL_URL=http://platform-api:8080/api/public/v1
PUBLIC_API_BROWSER_ORIGIN=http://localhost:8080
# Development-only escape hatch. When true, the banner and every non-essential
# first-party event are both disabled; production builds ignore this value.
VITE_DISABLE_COOKIE_BANNER=false
VITE_ADMIN_API_BASE_URL=http://localhost:8080/api/admin/v1
PUBLIC_HOST=www.airtek.localhost
ADMIN_HOST=admin.airtek.localhost
API_HOST=api.airtek.localhost
API_BROWSER_ORIGIN=http://localhost:8080

# Local persistence. These values are intentionally development-only. If any
# database credential changes, update both connection URLs as one unit.
AIRTEK_POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=airtek
POSTGRES_USER=airtek
POSTGRES_PASSWORD=airtek
AIRTEK_DATABASE_URL_INTERNAL=postgres://airtek:airtek@postgres:5432/airtek
DATABASE_URL=postgres://airtek:airtek@localhost:54320/airtek
# Flyway owns schema versioning. Keep its JDBC URL and local credentials in
# sync with POSTGRES_*; API/Worker continue to use the PostgreSQL URLs above.
AIRTEK_FLYWAY_BASE_IMAGE=flyway/flyway:13.4.0-alpine
AIRTEK_FLYWAY_TARGET=27
FLYWAY_URL=jdbc:postgresql://postgres:5432/airtek
FLYWAY_USER=airtek
FLYWAY_PASSWORD=airtek
FLYWAY_PLACEHOLDERS_RUNTIME_ROLE=airtek

# Management SPA
# Development and production both use the Rust API. UI fixtures live only in tests.
VITE_ENABLE_DEVTOOLS=false

# DevTools maintenance seeds the fixed local administrator and, only when the
# public CMS state is safe, a complete noindex development site shell.
AIRTEK_DEV_ADMIN_SEED=true
AIRTEK_DEV_PUBLIC_SEED=false

# Rust platform (API port is fixed at 8080)
AIRTEK_API_HOST=0.0.0.0
AIRTEK_PUBLIC_ORIGIN=http://localhost:3000
AIRTEK_ADMIN_ORIGIN=http://localhost:3100
# One-time setup secret; it is not accepted as a normal API bearer credential.
AIRTEK_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-secret-at-least-24-characters
# Known local-development key only. Replace it in .env before storing real user
# TOTP secrets. Production must inject an independently generated Base64 value
# that decodes to exactly 32 bytes.
AIRTEK_TOTP_ENCRYPTION_KEY=YWlydGVrLWxvY2FsLXRvdHAta2V5LWNoYW5nZS1tZSE=
# Independent keys for encrypted commercial fields in Product Master staging
# and HMAC-only anonymous analytics session tokens. Production must inject
# separately generated Base64 values that each decode to exactly 32 bytes.
AIRTEK_PRODUCT_STAGING_ENCRYPTION_KEY=YWlydGVrLWxvY2FsLXByb2R1Y3Qta2V5LTAwMDAwMDE=
AIRTEK_ANALYTICS_TOKEN_HMAC_KEY=YWlydGVrLWxvY2FsLWFuYWx5dGljcy1rZXktMDAwMDE=
# Independent local-only AEAD key for the short-lived encrypted invitation
# response kept by the idempotency layer. Production must inject another
# distinct Base64 value that decodes to exactly 32 bytes.
AIRTEK_INVITATION_REPLAY_ENCRYPTION_KEY=1W0w7CqiAMGqdDv20BLYWyynpf9wXcSUBGkq0uh7Imc=
# Raw consented visits/events are retained for 180 days; source aggregates for
# 24 months. Product imports include this version in their idempotency key.
AIRTEK_GUEST_RAW_RETENTION_DAYS=180
AIRTEK_GUEST_AGGREGATE_RETENTION_MONTHS=24
AIRTEK_PRODUCT_IMPORT_MAPPING_VERSION=airtek-basic-v1
# Reviewed Product Master authority tuple. Production requires all four values
# and rechecks them before staging, worker promotion, and public publication.
# Changing even one source byte requires a separately approved SHA-256.
AIRTEK_APPROVED_PRODUCT_MASTER_SHA256=e3b944d5d979c72d963ba353416ef452f9dac0bf63182bb09fc6b1201c043800
AIRTEK_APPROVED_PRODUCT_MASTER_MAPPING_VERSION=airtek-basic-v1
AIRTEK_APPROVED_PRODUCT_MASTER_VALID_ROWS=370
AIRTEK_APPROVED_PRODUCT_MASTER_ERROR_ROWS=5
# UTM values are not arbitrary input: only deployment-registered identifiers
# are stored. Keep these lists limited to campaigns actually issued by AIRTEK.
AIRTEK_ANALYTICS_ALLOWED_UTM_SOURCES=google,linkedin,newsletter,e2e-source
AIRTEK_ANALYTICS_ALLOWED_UTM_MEDIUMS=cpc,email,organic-social,integration-test
AIRTEK_ANALYTICS_ALLOWED_UTM_CAMPAIGNS=development,admin-acceptance
# Compose assigns the only trusted HTTP gateway a fixed address. If the subnet
# changes, update all three values together; never trust an entire private range.
AIRTEK_COMPOSE_SUBNET=172.28.0.0/24
AIRTEK_GATEWAY_INTERNAL_IP=172.28.0.10
AIRTEK_TRUSTED_PROXY_CIDRS=172.28.0.10/32
RUST_LOG=airtek_platform=info,tower_http=info

GA4_MEASUREMENT_ID=
